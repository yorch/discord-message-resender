# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=resender
POSTGRES_PASSWORD=change-me
POSTGRES_DB=resender

# Used by the api container (Prisma) and the ingest container (asyncpg).
# Host "postgres" is the compose service name.
DATABASE_URL=postgresql://resender:change-me@postgres:5432/resender

# ---------------------------------------------------------------------------
# Discord source account
# ---------------------------------------------------------------------------
# Your Discord USER token. Automating a user account violates Discord's Terms
# of Service and risks account termination. See docs/risk.md before filling in.
DISCORD_USER_TOKEN=

# ---------------------------------------------------------------------------
# Fan-out targets
# ---------------------------------------------------------------------------
# Webhook URLs referenced by name from config/routes.yaml. Add one env var per
# target channel in your own server. Names are arbitrary but must match the
# webhook_url_env value in the route definition.
WEBHOOK_ALPHA=
WEBHOOK_BETA=

# ---------------------------------------------------------------------------
# Query API
# ---------------------------------------------------------------------------
API_PORT=4000
# Bearer token required on every /alerts request. Generate with:
#   openssl rand -hex 32
API_TOKEN=
