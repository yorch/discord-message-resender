// Prisma owns the schema and the migrations for both services.
//
// The ingest service (Python) writes to these tables through asyncpg with
// hand-written SQL, so every field carries an explicit @map. Do not rely on
// Prisma's default column naming here: the snake_case names below are a
// contract with ingest/src/resender/db.py.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

// Prisma 7 removed `url` from the datasource block. The connection string for
// CLI and migrations lives in prisma.config.ts; the runtime client gets it via
// the driver adapter in src/prisma.ts.
datasource db {
  provider = "postgresql"
}

/// One captured Discord message. The primary key is the source snowflake, so a
/// replayed gateway event after a resume is an ON CONFLICT no-op rather than a
/// duplicate row.
model Message {
  id          String    @id
  guildId     String    @map("guild_id")
  guildName   String?   @map("guild_name")
  channelId   String    @map("channel_id")
  channelName String?   @map("channel_name")
  authorId    String    @map("author_id")
  authorName  String    @map("author_name")
  authorIsBot Boolean   @default(false) @map("author_is_bot")

  /// Plain message text. Frequently empty: most alert bots post embeds.
  content     String    @default("")
  /// content plus the human-readable text inside every embed, written by the
  /// ingest service. Lets search reach embed-only alerts, which is most of them,
  /// through a plain column filter instead of scanning JSON.
  searchText  String    @default("") @map("search_text")
  /// Array of Discord embed objects, the usual payload for bot-posted alerts.
  embeds      Json      @default("[]")
  attachments Json      @default("[]")
  /// Faithful snapshot of the message as the library exposed it. discord.py does
  /// not retain the original gateway frame, so this is reconstructed rather than
  /// captured verbatim. It exists so a later schema change can be backfilled from
  /// stored data instead of waiting for the traffic to recur.
  raw         Json

  sentAt      DateTime  @map("sent_at") @db.Timestamptz(6)
  editedAt    DateTime? @map("edited_at") @db.Timestamptz(6)
  capturedAt  DateTime  @default(now()) @map("captured_at") @db.Timestamptz(6)
  /// Set when the source message is deleted. The row is kept rather than removed:
  /// a retracted alert is itself a signal, and the archive should show that it
  /// existed and was withdrawn. Null means live.
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  deliveries  Delivery[]

  @@index([guildId, channelId, sentAt(sort: Desc)])
  @@index([sentAt(sort: Desc)])
  @@index([authorId])
  @@index([deletedAt])
  @@map("messages")
}

/// Per-route forwarding state. Kept out of Message because one capture can fan
/// out to several targets that fail independently, and because the composite
/// primary key is what prevents a restart from double-sending.
model Delivery {
  messageId     String         @map("message_id")
  /// Route name from config/routes.yaml.
  route         String
  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  lastError     String?        @map("last_error")
  deliveredAt   DateTime?      @map("delivered_at") @db.Timestamptz(6)
  /// Drives exponential backoff. The retry sweeper selects on this index rather
  /// than holding a queue in memory that a restart would lose.
  ///
  /// Microsecond precision is deliberate. At Timestamptz(3) the default value
  /// rounds to the nearest millisecond, which lands up to 0.5ms in the FUTURE
  /// about 60% of the time, so a row could be written and then miss a sweep
  /// running microseconds later.
  nextAttemptAt DateTime       @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  message       Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, route])
  @@index([status, nextAttemptAt])
  @@map("deliveries")
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  /// Matched a route but was filtered out. Recorded rather than dropped so the
  /// filters can be audited against real traffic.
  SKIPPED

  @@map("delivery_status")
}
